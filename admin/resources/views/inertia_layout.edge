<!DOCTYPE html>
<html lang="pt-BR" data-theme="tactical">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">

  <title inertia>Nexus Project NOMAD</title>

  <script>
    (function() {
      try {
        var valid = ['tactical', 'light', 'dark', 'survival', 'stealth'];
        var theme = localStorage.getItem('nomad:theme') || 'tactical';
        if (valid.indexOf(theme) === -1) theme = 'tactical';
        document.documentElement.setAttribute('data-theme', theme);
        var layout = localStorage.getItem('nomad:home_layout') || 'auto';
        document.documentElement.setAttribute('data-home-layout', layout);
      } catch(e) {}
    })();
  </script>

  @stack('dumper')
  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>

<body class="min-h-screen w-screen font-sans">
  @inertia()
</body>

</html>
